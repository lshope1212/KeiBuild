@inherits LayoutComponentBase
@inject IWebHostEnvironment HostEnvironment

<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
    <div class="shell header-inner">
        <a href="/" class="brand" aria-label="KeiBuild home"><span class="brand-mark" aria-hidden="true">K</span> KeiBuild</a>
        <nav class="primary-nav" aria-label="Main navigation">
            <NavLink href="/" Match="NavLinkMatch.All">Chassis</NavLink>
            <NavLink href="/parts">Parts &amp; mods</NavLink>
            @if (HostEnvironment.IsDevelopment())
            {
                <NavLink href="/review">Review inbox</NavLink>
            }
        </nav>
    </div>
</header>
<main id="main" class="shell site-main" tabindex="-1">
    @Body
</main>
<footer class="site-footer">
    <div class="shell footer-inner">
        <span class="footer-brand">KeiBuild</span>
        <span>Parts and fitment reference for Japanese kei trucks.</span>
    </div>
</footer>
